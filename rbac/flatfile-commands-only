k create ns ciao 
openssl genrsa -out max.pem 2048
openssl req -new -key max.pem -out max.csr -subj "/CN=max/O=ciao"
cat max.csr | base64 | tr -d "\n" && echo
CSR=$(cat max.csr | base64 | tr -d '\n')

k apply -f - <<EOF
apiVersion: certificates.k8s.io/v1
kind: CertificateSigningRequest
metadata:
  name: max
spec:
  request: $CSR
  signerName: kubernetes.io/kube-apiserver-client
  expirationSeconds: 31536000
  usages:
  - digital signature
  - key encipherment
  - client auth
EOF
k get csr
k certificate approve max
k get csr max -o jsonpath='{.status.certificate}' | base64 --decode > max.crt
cat max.crt | base64 | tr -d "\n" && echo  # output -> client-certificate-data
cat max.pem | base64 | tr -d "\n" && echo  # output -> client-key-data
k apply -f - <<EOF
apiVersion: rbac.authorization.k8s.io/v1
kind: Role
metadata:
  namespace: ciao
  name: max-prod-role
rules:
- apiGroups: [""]
  resources:
  - pods
  - pods/log
  - services
  - secrets
  - configmaps
  - pods/exec
  - pods/attach
  - pods/portforward
  verbs:
  - get
  - watch
  - list
  - create
  - delete
  - update
  - patch
- apiGroups: ["apps"]
  resources:
  - deployments
  verbs:
  - get
  - watch
  - list
  - create
  - delete
  - update
  - patch
- apiGroups: ["cert-manager.io"]
  resources:
  - issuers
  - certificates
  verbs:
  - get
  - watch
  - list
  - create
  - update
  - patch
  - delete
EOF
k apply -f - <<EOF
apiVersion: rbac.authorization.k8s.io/v1
kind: RoleBinding
metadata:
  name: max-prod-rolebinding
  namespace: ciao
subjects:
- kind: User
  name: max
  apiGroup: rbac.authorization.k8s.io
roleRef:
  kind: Role
  name: max-prod-role
  apiGroup: rbac.authorization.k8s.io
EOF
k apply -f - <<EOF
apiVersion: rbac.authorization.k8s.io/v1
kind: Role
metadata:
  namespace: ciao
  name: max-prod-monitor
rules:
- apiGroups: [""]
  resources:
  - pods
  - pods/log
  - services
  - events
  verbs:
  - get
  - list
  - watch
- apiGroups: ["apps"]
  resources:
  - deployments
  - replicasets
  verbs:
  - get
  - list
  - watch
- apiGroups: ["networking.k8s.io"]
  resources:
  - ingresses
  verbs:
  - get
  - list
  - watch
- apiGroups: ["cert-manager.io"]
  resources:
  - issuers
  - certificates
  verbs:
  - get
  - list
  - watch
EOF
k apply -f - <<EOF
apiVersion: rbac.authorization.k8s.io/v1
kind: RoleBinding
metadata:
  name: max-prod-monitor-binding
  namespace: ciao
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: Role
  name: max-prod-monitor
subjects:
- kind: User
  name: max
  apiGroup: rbac.authorization.k8s.io
EOF
IP=$(ip a show eth1 |grep inet|grep -v inet6|awk -F " " '{print $2}'|cut -d "/" -f1):6443
k config set-cluster kubernetes \
  --certificate-authority=/etc/kubernetes/pki/ca.crt \
  --embed-certs=true \
  --server=https://$IP \
  --kubeconfig=kubeconfig-max.yml
k config set-credentials max \
  --client-certificate=max.crt \
  --client-key=max.pem \
  --embed-certs=true \
  --kubeconfig=kubeconfig-max.yml
k config set-context max-context \
  --cluster=kubernetes \
  --namespace=ciao \
  --user=max \
  --kubeconfig=kubeconfig-max.yml
k config --kubeconfig=kubeconfig-max.yml use-context max-context
export KUBECONFIG=kubeconfig-max.yml
k get pods -n ciao
